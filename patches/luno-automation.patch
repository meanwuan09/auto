new file mode 100644
index 0000000..01dd3f3
--- /dev/null
+++ b/backend/roxy_browser.py
@@ -0,0 +1,93 @@
+"""Attach Playwright to an explicitly selected RoxyBrowser profile."""
+
+import json
+import os
+from pathlib import Path
+from urllib.parse import urlencode, urlparse
+from urllib.request import Request, urlopen
+
+
+CONFIG_FILE = Path(__file__).resolve().parents[3] / "data" / "roxy-browser.json"
+PROFILE_ROOT = Path(os.environ.get("APPDATA", "")) / "RoxyBrowser" / "browser-cache"
+# Set by a batch run that targets a specific profile; batches run one at a time.
+profile_override = None
+
+
+def config():
+    if not CONFIG_FILE.is_file():
+        return {}
+    return json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
+
+
+def selected():
+    return os.environ.get("TIKTOK_BROWSER", config().get("mode", "chrome")).lower() == "roxy"
+
+
+def _setting(name, environment):
+    return os.environ.get(environment) or config().get(name)
+
+
+def _request(path, method="GET", body=None):
+    port = int(_setting("api_port", "ROXY_API_PORT") or 50000)
+    if not 1 <= port <= 65535:
+        raise RuntimeError("Invalid RoxyBrowser API port")
+    token = _setting("api_token", "ROXY_API_TOKEN")
+    if not token:
+        raise RuntimeError("Set ROXY_API_TOKEN or api_token in data/roxy-browser.json")
+    url = f"http://127.0.0.1:{port}{path}"
+    payload = json.dumps(body).encode("utf-8") if body is not None else None
+    request = Request(url, data=payload, method=method, headers={"token": token, "Content-Type": "application/json"})
+    try:
+        with urlopen(request, timeout=30) as response:
+            result = json.load(response)
+    except OSError as error:
+        raise RuntimeError("RoxyBrowser OpenAPI is unavailable; enable it in API Configuration") from error
+    if result.get("code") != 0:
+        raise RuntimeError(f"RoxyBrowser API failed: {result.get('msg', 'unknown error')}")
+    return result.get("data")
+
+
+def connect(playwright):
+    profile_id = profile_override or _setting("profile_id", "ROXY_PROFILE_ID")
+    workspace_id = _setting("workspace_id", "ROXY_WORKSPACE_ID")
+    if not profile_id or not str(profile_id).isalnum():
+        raise RuntimeError("Set a valid RoxyBrowser profile_id in data/roxy-browser.json")
+    def via_api():
+        if not workspace_id:
+            raise RuntimeError("Open the selected RoxyBrowser profile, or configure workspace_id and OpenAPI")
+        try:
+            opened = _request("/browser/connection_info?" + urlencode({"dirIds": str(profile_id)}))
+            current = next((item for item in opened if item.get("dirId") == str(profile_id)), None) if isinstance(opened, list) else None
+            data = current or _request("/browser/open", "POST", {"workspaceId": str(workspace_id), "dirId": str(profile_id), "forceOpen": False})
+            return data.get("ws") if isinstance(data, dict) else None
+        except RuntimeError as error:
+            raise RuntimeError("Open the selected RoxyBrowser profile manually or enable its OpenAPI") from error
+
+    def attach(endpoint):
+        parsed = urlparse(endpoint or "")
+        if parsed.scheme != "ws" or parsed.hostname not in {"127.0.0.1", "localhost"}:
+            raise RuntimeError("RoxyBrowser returned an invalid local CDP endpoint")
+        return playwright.chromium.connect_over_cdp(endpoint)
+
+    # DevToolsActivePort outlives a closed profile, so a failed attach through it falls back
+    # to the OpenAPI, which reports the running endpoint or opens the profile.
+    active_port = PROFILE_ROOT / str(profile_id) / "DevToolsActivePort"
+    browser = None
+    if active_port.is_file():
+        lines = active_port.read_text(encoding="utf-8").splitlines()
+        if len(lines) >= 2 and lines[0].isdigit() and lines[1].startswith("/devtools/browser/"):
+            try:
+                browser = attach(f"ws://127.0.0.1:{lines[0]}{lines[1]}")
+            except Exception:
+                browser = None
+    if browser is None:
+        try:
+            browser = attach(via_api())
+        except RuntimeError:
+            raise
+        except Exception as error:
+            raise RuntimeError("RoxyBrowser profile is not reachable; reopen it and retry") from error
+    if not browser.contexts:
+        browser.close()
+        raise RuntimeError("RoxyBrowser profile has no browser context")
+    return browser, browser.contexts[0]
