+def set_ai_label(page):
+    """Bật "Nội dung do AI tạo" (Hiển thị thêm → công tắc → hộp xác nhận "Bật").
+    TikTok yêu cầu nhãn này cho nội dung hoàn toàn do AI tạo hoặc chỉnh sửa đáng kể."""
+    for label in ("Hiển thị thêm", "Show more"):
+        more = page.get_by_text(label, exact=True)
+        if more.count() and more.first.is_visible():
+            more.first.click()
+            time.sleep(1)
+            break
+    title = page.get_by_text("Nội dung do AI tạo", exact=True)
+    if not title.count():
+        title = page.get_by_text("AI-generated content", exact=True)
+    row = page.locator('div').filter(has=title.first).filter(has=page.locator('input[role="switch"]')).last
+    switch = row.locator('input[role="switch"]').first
+    if switch.is_checked():
+        return
+    toggle = row.locator('[class*=Switch]').first
+    (toggle if toggle.count() else switch).click(force=not toggle.count())
+    time.sleep(1.5)
+    dialog = page.locator('.TUXModal-overlay').filter(has_text="nội dung do AI tạo")
+    if not dialog.count():
+        dialog = page.locator('.TUXModal-overlay').filter(has_text="AI-generated")
+    if dialog.count() and dialog.first.is_visible():
+        dialog.first.get_by_role("button", name="Bật", exact=True).or_(dialog.first.get_by_role("button", name="Turn on", exact=True)).first.click(timeout=10000)
